# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- Model access ---------------------------------------------------------
# Vertex AI (default). Requires `gcloud auth application-default login`.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Or use Google AI Studio instead: comment out the three lines above and
# uncomment this one.
# GEMINI_API_KEY=your-api-key-here

# --- ClickHouse -----------------------------------------------------------
# The story graph, costs and suggestions all live here. The agents read via
# the mcp-clickhouse MCP server; the write tools use clickhouse_connect.
# These are read once at import time (app/app_utils/clickhouse_client.py),
# so a missing value bakes in a placeholder for the life of the process.
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# --- Server ---------------------------------------------------------------
# Browser origins allowed to call this API, comma-separated. The frontend dev
# server runs on :8080. Leave this unset and ADK rejects every cross-origin
# request with "403 origin not allowed" before it reaches a route.
ALLOW_ORIGINS=http://localhost:8080

# Ships traces to Google Cloud Monitoring. Off locally: without usable
# credentials the exporter retries every second and floods the log with
# "Failed to export metrics batch code: 400".
OTEL_TO_CLOUD=false

# --- Optional, deployment only --------------------------------------------
# All have working defaults; none are needed to run locally.
# APP_URL                  Public URL this service is reachable at. Only used
#                          for the A2A agent card; defaults to 0.0.0.0:8000.
# SESSION_SERVICE_URI      Swaps the in-memory session store for a persistent
#                          one. Without it, restarting drops every session
#                          and any paused clarifying question.
# LOGS_BUCKET_NAME         GCS bucket for artifacts, replacing in-memory.
# AGENT_VERSION            Stamped into the A2A card; set as a Docker build arg.
